{
  "name": "notaai-worker",
  "version": "0.1.0",
  "private": true,
  "description": "NotaAI Worker — Cloud Run, antrean OCR multibahasa & koreksi ujian (1.000 CCU)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
