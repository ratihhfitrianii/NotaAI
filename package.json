    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^4.19.2",
    "jpeg-js": "^0.4.4",
    "multer": "^2.3.0",
    "pg": "^8.12.0",
    "pinyin-pro": "^3.24.0",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jpeg-js": "^0.3.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
