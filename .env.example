# ===== NotaAI Worker (Cloud Run) =====
NODE_ENV=development
PORT=8080

# Antrean: memory (lokal/dev) | upstash (produksi, Kafka REST)
QUEUE_DRIVER=memory
QUEUE_TOPIC=ocr-processing-queue
# Auto-scale horizontal: jumlah worker paralel yang men-drain antrean di satu instance
CONSUMER_INSTANCES=4

# OCR: tesseract (lokal, tanpa API key) | mock (placeholder) | real (Mathpix/Google Vision)
OCR_MODE=tesseract
LLM_MODE=mock

# Upstash Kafka (REST) — wajib jika QUEUE_DRIVER=upstash
UPSTASH_KAFKA_URL=
UPSTASH_KAFKA_USERNAME=
UPSTASH_KAFKA_PASSWORD=
UPSTASH_KAFKA_GROUP=notaai-worker
# Set unik per instance saat auto-scale (default: random)
UPSTASH_KAFKA_INSTANCE=

# OCR providers — wajib jika OCR_MODE=real
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
GOOGLE_VISION_API_KEY=

# LLM — wajib jika LLM_MODE=real (Gemini 2.5 Flash, grammar Inggris + korektor JSON)
GEMINI_API_KEY=

# Storage & DB
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=exam-photos
# Supavisor (transaction pooling, port 6543, pgbouncer=true) — wajib di produksi
DATABASE_URL=